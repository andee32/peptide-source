# Environment. Copy to .env and fill in. NEVER commit .env.

# --- Brand (single source of truth — see lib/brand) ---
# One unprefixed set drives both runtimes: the API reads these directly and the
# storefront inlines them at build time (vite-plugin-brand). Restart the dev
# server after changing them.
BRAND_NAME=Peptide Source
BRAND_LEGAL_NAME=Peptide Source LLC
BRAND_SHORT_NAME=Peptide Source
# Uppercase wordmark; defaults to BRAND_NAME uppercased.
BRAND_WORDMARK=
BRAND_TAGLINE=Lab-verified research peptide sourcing, built for wholesale.
# Apex domain — support/from addresses and the site URL derive from it.
BRAND_DOMAIN=example.com
BRAND_SUPPORT_EMAIL=
BRAND_SUPPORT_PHONE=
# Postal address of the legal entity, shown on the legal pages and required in
# any promotional email (CAN-SPAM). Use \n for line breaks.
BRAND_POSTAL_ADDRESS=
# Jurisdiction whose law governs the Terms of Use, e.g. "Delaware".
BRAND_GOVERNING_LAW=
# Served from artifacts/storefront/public — drop in real assets and repoint.
BRAND_LOGO_SRC=/brand/logo.svg
BRAND_ICON_SRC=/brand/icon.svg
BRAND_OG_IMAGE_SRC=/brand/logo.svg
BRAND_THEME_COLOR="#f5f4f0"
BRAND_BACKGROUND_COLOR="#f5f4f0"

# --- Brand palette (storefront skin; inlined at build time — restart dev) ---
# Roles, not colour names: STRUCTURE = headings/nav/footer, PRIMARY = CTAs and
# focus rings, ACCENT = premium/COA-verified. Unset keys fall back to the
# defaults in lib/brand/src/palette.ts.
BRAND_COLOR_STRUCTURE="#1a4d6e"
BRAND_COLOR_STRUCTURE_DARK="#123a54"
BRAND_COLOR_STRUCTURE_DEEP="#0a1628"
BRAND_COLOR_SECONDARY="#2e7da8"
BRAND_COLOR_SECONDARY_TINT="#d6eaf5"
BRAND_COLOR_PRIMARY="#00b4c4"
BRAND_COLOR_PRIMARY_DARK="#0797a6"
BRAND_COLOR_ACCENT="#c8a84b"
BRAND_COLOR_ACCENT_TINT="#f3ecd3"
BRAND_COLOR_BACKGROUND="#f5f4f0"
BRAND_COLOR_SURFACE="#ffffff"
BRAND_COLOR_SURFACE_RAISED="#ecefec"
BRAND_COLOR_INK="#0e1117"
BRAND_COLOR_INK_MUTED="#6b7280"
BRAND_COLOR_BORDER="#d1d9e0"
BRAND_COLOR_SUCCESS="#167a52"
BRAND_COLOR_SUCCESS_TINT="#d6ece1"
BRAND_COLOR_WARNING="#b5750a"
BRAND_COLOR_WARNING_TINT="#f4e8cf"
BRAND_COLOR_DANGER="#c0392b"
BRAND_COLOR_DANGER_TINT="#f6dcd8"

# Full CSS font stacks; unset falls back to the palette defaults. Hex values
# need the quotes above — dotenv reads a bare leading `#` as a comment (a bare
# `1a4d6e` also works). BRAND_FONT_CSS_URL loads the families; set it to an
# explicit empty string for self-hosted or system fonts (no <link> emitted).
BRAND_FONT_DISPLAY=
BRAND_FONT_BODY=
BRAND_FONT_MONO=
BRAND_FONT_CSS_URL="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&family=Lato:wght@300;400;700;900&family=DM+Mono:wght@400;500&display=swap"

# --- Server ---
PORT=8080
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
SITE_URL=http://localhost:5173

# Set to 1 in any deploy pipeline: the storefront build then REFUSES to produce a
# bundle while legal documents are still marked as awaiting counsel approval
# (artifacts/storefront/src/pages/legal/status.ts).
ENFORCE_LEGAL_REVIEW=

# --- Shipping destination policy (enforced server-side on orders and
#     subscriptions; see artifacts/api-server/src/lib/shippingPolicy.ts) ---
# Where we may ship is a legal question, so keep it here rather than in code and
# update it as counsel advises. Blocks always beat allows.
# Comma-separated ISO-3166 alpha-2 country codes; defaults to US only.
SHIP_ALLOWED_COUNTRIES=US
SHIP_BLOCKED_COUNTRIES=
# US states, abbreviation or full name. An empty allow list means every state
# that is not explicitly blocked.
SHIP_ALLOWED_STATES=
SHIP_BLOCKED_STATES=

# --- Database (Neon Postgres) ---
# Local dev with `docker compose up -d`: postgres://app:app@localhost:5432/app
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Admin / back-office auth ---
# Set a real admin email + hash before any deployment.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=dev-admin-local-only
ADMIN_EMAIL=admin@example.com
# PBKDF2 hash (salt:hash). See artifacts/api-server/src/routes/admin.ts for the scheme.
ADMIN_PASSWORD_HASH=1f32f604d8bd33328bdb5b2bf3a8a2ce:7b5299542d995025ed086bd0f13fea2694af2ba8b04f4c77c1cf84d4e99c651a

# --- Crypto payments (BTCPayServer) — crypto-first rail ---
# If any of URL/API_KEY/STORE_ID is missing, the server REFUSES to create
# invoices (503) rather than handing out a fake pay-to address.
BTCPAYSERVER_URL=
BTCPAYSERVER_API_KEY=
BTCPAYSERVER_STORE_ID=
# Dedicated webhook secret is REQUIRED — unsigned/unconfigured webhooks are rejected.
BTCPAYSERVER_WEBHOOK_SECRET=
BTCPAYSERVER_USDC_METHOD=ETH_USDC20

# --- Transactional email (peptide-tolerant ESP: Postmark / Amazon SES) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to BRAND_SUPPORT_EMAIL / noreply@BRAND_DOMAIN when unset.
SMTP_FROM=

# --- Claude API (AI extraction service) ---
# Claude API key for AI extraction of uploaded COA documents (admin upload flow).
# Optional: without it, uploads still save and admins enter COA values manually.
ANTHROPIC_API_KEY=

# --- Optional ---
REVIEWER_WEBHOOK_URL=
