# Environment. Copy to .env and fill in. NEVER commit .env.

# --- Brand (single source of truth — see lib/brand) ---
# One unprefixed set drives both runtimes: the API reads these directly and the
# storefront inlines them at build time (vite-plugin-brand). Restart the dev
# server after changing them.
BRAND_NAME=Peptide Source
BRAND_LEGAL_NAME=Peptide Source LLC
BRAND_SHORT_NAME=Peptide Source
# Uppercase wordmark; defaults to BRAND_NAME uppercased.
BRAND_WORDMARK=
BRAND_TAGLINE=Lab-verified research peptide sourcing, built for wholesale.
# Apex domain — support/from addresses and the site URL derive from it.
BRAND_DOMAIN=example.com
BRAND_SUPPORT_EMAIL=
BRAND_SUPPORT_PHONE=
# Served from artifacts/storefront/public — drop in real assets and repoint.
BRAND_LOGO_SRC=/brand/logo.svg
BRAND_ICON_SRC=/brand/icon.svg
BRAND_OG_IMAGE_SRC=/brand/logo.svg
BRAND_THEME_COLOR=#f5f4f0
BRAND_BACKGROUND_COLOR=#f5f4f0

# --- Server ---
PORT=8080
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
SITE_URL=http://localhost:5173

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Admin / back-office auth ---
# Set a real admin email + hash before any deployment.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=dev-admin-local-only
ADMIN_EMAIL=admin@example.com
# PBKDF2 hash (salt:hash). See artifacts/api-server/src/routes/admin.ts for the scheme.
ADMIN_PASSWORD_HASH=1f32f604d8bd33328bdb5b2bf3a8a2ce:7b5299542d995025ed086bd0f13fea2694af2ba8b04f4c77c1cf84d4e99c651a

# --- Crypto payments (BTCPayServer) — crypto-first rail ---
# If any of URL/API_KEY/STORE_ID is missing, the server REFUSES to create
# invoices (503) rather than handing out a fake pay-to address.
BTCPAYSERVER_URL=
BTCPAYSERVER_API_KEY=
BTCPAYSERVER_STORE_ID=
# Dedicated webhook secret is REQUIRED — unsigned/unconfigured webhooks are rejected.
BTCPAYSERVER_WEBHOOK_SECRET=
BTCPAYSERVER_USDC_METHOD=ETH_USDC20

# --- Transactional email (peptide-tolerant ESP: Postmark / Amazon SES) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to BRAND_SUPPORT_EMAIL / noreply@BRAND_DOMAIN when unset.
SMTP_FROM=

# --- Claude API (AI extraction service) ---
# Claude API key for AI extraction of uploaded COA documents (admin upload flow).
# Optional: without it, uploads still save and admins enter COA values manually.
ANTHROPIC_API_KEY=

# --- Optional ---
REVIEWER_WEBHOOK_URL=
