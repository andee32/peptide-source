{
  "name": "@atlab/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=../../.env --import tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "vitest run",
    "test:db": "node --import tsx ./test/setup/createTestDb.ts",
    "test:integration": "pnpm run test:db && node --import tsx --import ./test/setup/env.ts --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@atlab/api-zod": "workspace:*",
    "@atlab/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.6.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.3",
    "qrcode": "^1.5.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.27.3",
    "pg": "^8.20.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
