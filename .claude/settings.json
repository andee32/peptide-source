{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm run *)",
      "Bash(pnpm -r *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm rebuild *)",
      "Bash(tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(pnpm --filter @app/db run push*)",
      "Bash(pnpm --filter @app/db run push-force*)",
      "Write(**/openapi.yaml)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm run typecheck >/tmp/atlab-typecheck.log 2>&1 || { echo 'Stop gate: pnpm run typecheck FAILED — see /tmp/atlab-typecheck.log' >&2; tail -20 /tmp/atlab-typecheck.log >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
