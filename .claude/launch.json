{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@atlab/api-server",
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "storefront",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PROXY_TARGET=http://localhost:8081",
        "pnpm",
        "--config.verify-deps-before-run=false",
        "--filter",
        "@atlab/storefront",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "mockup-sandbox",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@atlab/mockup-sandbox",
        "run",
        "dev"
      ],
      "port": 5174
    }
  ]
}
